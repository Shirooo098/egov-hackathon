PORT=5000
NODE_ENV=development
EBUHAY_MODE=synthetic
# Required as APPROVED_SERVICE=blood for controlled-live/production; no kidney service is approved.
APPROVED_SERVICE=
SHUTDOWN_TIMEOUT_MS=10000
# Comma-separated browser origins. Live modes must use approved HTTPS origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Per-process v1 request throttle (deployment-wide limiting requires an external store).
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
# Sessions have an absolute maximum of eight hours and expire after 30 minutes idle.
SESSION_TTL_MS=28800000
# Synthetic-only eGov contract-double signing secret; never use for live modes.
EGOV_SYNTHETIC_SECRET=replace-with-local-random-secret
# Required for staff MFA provisioning/sign-in; generate 32 random bytes, encoded as 64 hex characters.
STAFF_MFA_ENCRYPTION_KEY=

# DICT eVerify Credentials
EVERIFY_CLIENT_ID=dict_everify_demo_client_id
EVERIFY_CLIENT_SECRET=dict_everify_demo_client_secret
EVERIFY_API_URL=https://everify.e.gov.ph/api

# DICT eMessage Credentials
EMESSAGE_API_TOKEN=dict_emessage_demo_token
EMESSAGE_API_URL=https://emessage.e.gov.ph/messaging/v1

# DICT eGovAI Credentials
EGOVAI_ACCESS_CODE=dict_egovai_demo_access_code
EGOVAI_API_URL=https://egovai.e.gov.ph/api/v1/egov/integration

# DICT Besu Blockchain RPC
BESU_RPC_URL=https://hackathon-blockchain.e.gov.ph
BESU_CHAIN_ID=13371

# Neon/PostgreSQL configuration (pooled URL for runtime queries)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/ebuhay?sslmode=require
# Optional unpooled/direct URL for migrations and isolated tests
DATABASE_DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/ebuhay?sslmode=require
# Optional isolated PostgreSQL URL for Drizzle checks/introspection in tests
TEST_DATABASE_DIRECT_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/ebuhay_test?sslmode=require
TEST_DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/ebuhay_test?sslmode=require
DATABASE_SSL=true
DB_POOL_MAX=10
DB_CONNECTION_MODE=pool
DB_MIGRATION_MODE=direct
SYNTHETIC_HOSPITAL_SOURCE_ID=synthetic-hospital
SYNTHETIC_HOSPITAL_ID=00000000-0000-4000-8000-000000000001
SYNTHETIC_HOSPITAL_SIGNING_SECRET=replace-with-at-least-32-random-characters
