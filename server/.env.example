PORT=5000
NODE_ENV=development

# DICT eVerify Credentials
EVERIFY_CLIENT_ID=dict_everify_demo_client_id
EVERIFY_CLIENT_SECRET=dict_everify_demo_client_secret
EVERIFY_API_URL=https://everify.e.gov.ph/api

# DICT eMessage Credentials
EMESSAGE_API_TOKEN=dict_emessage_demo_token
EMESSAGE_API_URL=https://emessage.e.gov.ph/messaging/v1

# DICT eGovAI Credentials
EGOVAI_ACCESS_CODE=dict_egovai_demo_access_code
EGOVAI_API_URL=https://egovai.e.gov.ph/api/v1/egov/integration

# Blockchain Anchoring (real on-chain, not mocked)
# BESU_MODE: 'sepolia' (default, reliable public testnet) or 'besu' (DICT hackathon node)
BESU_MODE=sepolia
# Alchemy private Sepolia endpoint (faster + more reliable than the public default)
BESU_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/alch_aPK4aazFO2JHaNe6WH1zz
BESU_CHAIN_ID=11155111
# TESTNET KEY ONLY. Generate with:
#   node -e "const {Wallet}=require('ethers'); const w=Wallet.createRandom(); console.log('Address:',w.address); console.log('Key:',w.privateKey);"
# Fund via https://sepoliafaucet.com — never use a key that holds real ETH.
BESU_PRIVATE_KEY=
# Optional: explicit destination address (defaults to the wallet's own address)
ANCHOR_WALLET_ADDRESS=
EXPLORER_URL=https://sepolia.etherscan.io

# For DICT Besu mode, swap to:
# BESU_MODE=besu
# BESU_RPC_URL=https://hackathon-blockchain.e.gov.ph
# BESU_CHAIN_ID=13371
# EXPLORER_URL=https://hackathon-explorer.e.gov.ph

# Supabase Database Configuration
SUPABASE_URL=https://demo-supabase-project.supabase.co
SUPABASE_ANON_KEY=demo_supabase_anon_key
