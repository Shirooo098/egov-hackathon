{
  "name": "ebuhay-server",
  "version": "1.0.0",
  "description": "eBuhay DICT eGov Organ & Blood Matching Platform Backend API",
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "start": "tsx src/start.ts",
    "worker": "tsx src/worker.ts",
    "dev": "tsx watch src/start.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed:synthetic": "tsx src/db/seeds/synthetic.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:check": "drizzle-kit check --config=drizzle.config.ts",
    "db:introspect": "drizzle-kit introspect --config=drizzle.config.ts",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@neon/config": "^1.3.2",
    "@neon/env": "^1.2.3",
    "axios": "^1.18.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.10",
    "oxlint": "^1.82.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "qs": "6.16.0"
  }
}
