{
  "version": 2,
  "builds": [
    {
      "src": "server/src/app.ts",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "server/src/app.ts" },
    { "src": "/api", "dest": "server/src/app.ts" },
    { "src": "/assets/(.*)", "dest": "client/assets/$1" },
    { "src": "/(.*\\..*)", "dest": "client/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "client/index.html" }
  ]
}
