  "components": [
    {"name": "Primary Button", "kind": "button", "refersTo": "button-primary", "description": "Primary action for civic workflow progression.", "html": "<button class=\"ds-btn-primary\">Continue</button>", "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;padding:10px 20px;border:0;border-radius:12px;background:#0038A8;color:#fff;font:600 14px 'Noto Sans',sans-serif;cursor:pointer;transition:background 150ms,box-shadow 150ms,transform 150ms}.ds-btn-primary:hover{background:#0057D9;box-shadow:0 12px 26px rgba(0,56,168,.22)}.ds-btn-primary:active{background:#00287A;transform:translateY(1px)}.ds-btn-primary:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(0,56,168,.14)}"},
    {"name": "Danger Button", "kind": "button", "refersTo": "button-danger", "description": "Destructive action that requires clear semantic signaling.", "html": "<button class=\"ds-btn-danger\">Remove donor</button>", "css": ".ds-btn-danger{display:inline-flex;align-items:center;justify-content:center;padding:10px 20px;border:0;border-radius:12px;background:#CE1126;color:#fff;font:600 14px 'Noto Sans',sans-serif;cursor:pointer;transition:background 150ms,box-shadow 150ms}.ds-btn-danger:hover{background:#A30D1E;box-shadow:0 8px 20px rgba(206,17,38,.2)}.ds-btn-danger:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(206,17,38,.16)}"},
    {"name": "Text Input", "kind": "input", "refersTo": "input", "description": "Readable field for citizen and clinical workflow details.", "html": "<label class=\"ds-input-label\">Email<input class=\"ds-input\" placeholder=\"name@example.com\"></label>", "css": ".ds-input-label{display:grid;gap:6px;color:#94A3B8;font:700 11px 'Noto Sans',sans-serif;letter-spacing:.07em;text-transform:uppercase}.ds-input{width:100%;padding:9px 13px;border:1px solid #E2E8F0;border-radius:12px;background:#fff;color:#0F172A;font:400 14px/1.6 'Noto Sans',sans-serif;transition:border-color 150ms,box-shadow 150ms}.ds-input::placeholder{color:#94A3B8}.ds-input:hover{border-color:#CBD5E1}.ds-input:focus-visible{outline:0;border-color:#0038A8;box-shadow:0 0 0 3px rgba(0,56,168,.1)}"},
    {"name": "Navigation Tab", "kind": "nav", "refersTo": "button-primary", "description": "Pill navigation with a calm inactive state and clear active responsibility.", "html": "<nav class=\"ds-nav\"><button class=\"ds-tab\">Profile</button><button class=\"ds-tab ds-tab-active\">Matches</button></nav>", "css": ".ds-nav{display:flex;gap:4px;align-items:center}.ds-tab{padding:9px 16px;border:1px solid transparent;border-radius:9999px;background:transparent;color:#64748B;font:600 13.5px 'Noto Sans',sans-serif;cursor:pointer;transition:background 150ms,color 150ms}.ds-tab:hover{background:#F8FAFC;color:#0F172A}.ds-tab-active{background:#0038A8;color:#fff;box-shadow:0 4px 12px rgba(0,56,168,.25)}.ds-tab:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(0,56,168,.14)}"},
    {"name": "Status Badge", "kind": "chip", "refersTo": "button-primary", "description": "Compact semantic state marker for verified, waiting, and risk context.", "html": "<span class=\"ds-badge\">Verified</span>", "css": ".ds-badge{display:inline-flex;align-items:center;padding:3px 10px;border:1px solid rgba(5,150,105,.2);border-radius:9999px;background:rgba(5,150,105,.08);color:#047857;font:700 11px 'Noto Sans',sans-serif;letter-spacing:.03em;text-transform:uppercase}.ds-badge:hover{border-color:#059669;background:rgba(5,150,105,.14)}.ds-badge:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(5,150,105,.14)}"},
    {"name": "Working Card", "kind": "card", "refersTo": "card", "description": "Reassuring working surface for grouped workflow content.", "html": "<article class=\"ds-card\"><h3>Donation profile</h3><p>Ready for review.</p></article>", "css": ".ds-card{padding:24px;border:1px solid #E2E8F0;border-radius:22px;background:#fff;color:#0F172A;box-shadow:0 12px 34px rgba(15,23,42,.07);transition:border-color 250ms,box-shadow 250ms,transform 250ms}.ds-card:hover{border-color:#CBD5E1;box-shadow:0 18px 42px rgba(15,23,42,.1);transform:translateY(-2px)}.ds-card h3{margin:0 0 8px;font:800 18px/1.2 'Figtree',sans-serif}.ds-card p{margin:0;color:#64748B;font:400 14px/1.55 'Noto Sans',sans-serif}.ds-card:focus-within{box-shadow:0 0 0 3px rgba(0,56,168,.14),0 12px 34px rgba(15,23,42,.07)}"},
    {"name": "Review Modal", "kind": "custom", "refersTo": "card", "description": "Protected confirmation surface for genuinely interruptive review tasks.", "html": "<div class=\"ds-modal-wrap\"><section class=\"ds-modal\"><header>Review request</header><div>Check the details before continuing.</div><footer><button class=\"ds-modal-action\">Continue</button></footer></section></div>", "css": ".ds-modal-wrap{position:fixed;inset:0;display:grid;place-items:center;padding:20px;background:rgba(15,23,42,.65);backdrop-filter:blur(6px)}.ds-modal{width:min(540px,100%);overflow:hidden;border:1px solid #E2E8F0;border-radius:22px;background:#fff;color:#0F172A;box-shadow:0 28px 60px rgba(15,23,42,.13);font:400 14px/1.6 'Noto Sans',sans-serif}.ds-modal header{padding:20px 24px;border-bottom:1px solid #E2E8F0;font:800 18px/1.2 'Figtree',sans-serif}.ds-modal>div{padding:24px}.ds-modal footer{display:flex;justify-content:flex-end;padding:20px 24px;background:#F8FAFC;border-top:1px solid #E2E8F0}.ds-modal-action{padding:10px 20px;border:0;border-radius:12px;background:#0038A8;color:#fff;font:600 14px 'Noto Sans',sans-serif;cursor:pointer}.ds-modal-action:hover{background:#0057D9}.ds-modal-action:focus-visible{outline:0;box-shadow:0 0 0 3px rgba(0,56,168,.14)}"},
    {"name": "Progress Stepper", "kind": "custom", "refersTo": "card", "description": "Five-stage workflow progress with active and completed semantic states.", "html": "<ol class=\"ds-stepper\"><li class=\"ds-step ds-step-done\"><span>1</span><small>Profile</small></li><li class=\"ds-step ds-step-active\"><span>2</span><small>Review</small></li><li class=\"ds-step\"><span>3</span><small>Consent</small></li></ol>", "css": ".ds-stepper{display:flex;align-items:flex-start;margin:0;padding:0;list-style:none}.ds-step{position:relative;z-index:1;display:flex;flex:1;flex-direction:column;align-items:center;gap:8px;color:#64748B;font:600 11px 'Noto Sans',sans-serif;text-align:center}.ds-step:not(:last-child):after{content:'';position:absolute;top:14px;left:50%;width:100%;height:2px;background:#E2E8F0;z-index:-1}.ds-step span{display:grid;place-items:center;width:28px;height:28px;border:2px solid #E2E8F0;border-radius:50%;background:#fff;color:#94A3B8;font:800 12px 'Figtree',sans-serif}.ds-step-done span{border-color:#059669;background:#059669;color:#fff}.ds-step-active span{border-color:#0038A8;background:#0038A8;color:#fff;box-shadow:0 0 0 4px rgba(0,56,168,.08)}.ds-step-active,.ds-step-done{color:#0F172A}.ds-step:focus-within span{box-shadow:0 0 0 3px rgba(0,56,168,.14)}"},
    {"name": "Upload Dropzone", "kind": "custom", "refersTo": "card", "description": "Calm file intake that confirms upload without claiming verification.", "html": "<label class=\"ds-upload\">Upload supporting document<input type=\"file\"></label>", "css": ".ds-upload{display:grid;gap:8px;place-items:center;padding:24px;border:1px dashed #CBD5E1;border-radius:16px;background:#F8FAFC;color:#64748B;font:600 14px 'Noto Sans',sans-serif;cursor:pointer;transition:border-color 150ms,background 150ms,color 150ms}.ds-upload input{position:absolute;width:1px;height:1px;opacity:0}.ds-upload:hover{border-color:#0038A8;background:#F1F5F9;color:#0038A8}.ds-upload:focus-within{outline:0;box-shadow:0 0 0 3px rgba(0,56,168,.14)}"
    }
  ],
  "narrative": {
    "northStar": "The Civic Care Console",
    "overview": "The eBuhay visual system is humane, hopeful, civic; approachable but disciplined. It supports an eBuhay web demo/prototype that makes a donation and transplant workflow understandable without implying official endorsement, production integrations, or verified real-world records.\n\nThe incumbent interface uses a light-only canvas, strong Philippine-blue primary actions, clear status colors, generous rounded surfaces, and restrained ambient depth. It should feel reassuring and tactile while remaining operationally legible: a caring public service console, not a flashy startup and not sterile hospital software or dense admin tables.",
    "keyCharacteristics": ["Humane, hopeful civic tone with disciplined hierarchy.", "Light surfaces, high-contrast text, and a blue-led semantic palette.", "Tactile, reassuring controls with layered ambient depth.", "Responsive, role-aware workflow presentation."],
    "rules": [
      {"name": "The Civic Signal Rule", "body": "Use color to communicate responsibility or state first; keep decorative color rare.", "section": "colors"},
      {"name": "The Prototype Truth Rule", "body": "Visual polish must not imply official endorsement, production integrations, or verified real-world activity.", "section": "colors"},
      {"name": "The Clear Responsibility Rule", "body": "Use weight and size to make the user's next responsibility obvious before adding decoration.", "section": "typography"},
      {"name": "The Ambient Layer Rule", "body": "Shadows separate working surfaces; they do not become decorative outlines or hard-offset effects.", "section": "elevation"}
    ],
    "dos": ["**Do** keep the north star as **The Civic Care Console**: humane, hopeful, civic; approachable but disciplined.", "**Do** use eBuhay Blue for primary actions and semantic red, gold, and green only for their responsibilities.", "**Do** preserve light surfaces, 1200px content, the observed spacing/radius scales, and visible keyboard focus.", "**Do** keep cards, controls, tabs, modals, steppers, and uploads tactile and reassuring.", "**Do** label the interface as an eBuhay web demo/prototype when context could be mistaken for official or production activity."],
    "donts": ["**Don't** use flashy startup/decorative-tech aesthetics, ornamental gradients, or color without a civic purpose.", "**Don't** use sterile hospital software/dense admin tables as the visual model.", "**Don't** turn inline one-offs, a single page composition, or seeded demo data into design-system invariants.", "**Don't** imply official endorsement, production integrations, legal certainty, immutable records, or verified real-world status.", "**Don't** trade accessibility basics for polish: preserve contrast, reduced motion, high contrast, touch-safe sizing, and focus states."]
  }
}
